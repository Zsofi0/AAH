  void intercalarPriAscNoPriDesc(int& n){
      int nn=0,d=0,nAsc,nDes;
      bool encontre=false;
      ordenarAsc(n);
      nAsc=n;
      invertir(n);
      nDes=n;
      while(nAsc>0 or nDes>0){
          encontre=false;
          while(nDes>0 and encontre==false){
              d=nDes%10;
              nDes=nDes/10;
              if(d==2 or d==3 or d==5 or d==7){
                  nn=nn*10+d;
                  encontre=true;
              }
          }
          encontre=false;
           while(nAsc>0 and encontre==false){
              d=nAsc%10;
              nAsc=nAsc/10;
              if(d!=2 and d!=3 and d!=5 and d!=7){
                  nn=nn*10+d;
                  encontre=true;
              }
          }
      }
      n=nn;
      
  }
   
