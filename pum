// verificar si un digito es primo
bool esPrimo(int d){
    return (d==2 || d==3 || d==5 || d==7);
}

// 1) Encontrar el 2do dígito primo
// Ej: 4312678 => 2
int segundoDigPrimo(int n){
    int nc = n, d = 0, c = 0;
    int nn = 0;

    // invertir numero
    while(nc > 0){
        d = nc % 10;
        nc = nc / 10;
        nn = nn * 10 + d;
    }

    while(nn > 0){
        d = nn % 10;
        nn = nn / 10;

        if(esPrimo(d)){
            c++;
            if(c == 2){
                return d;
            }
        }
    }

    return -1;
}

// frecuencia de un digito
int frecuenciaDig(int n, int dig){
    int nc = n, d = 0, c = 0;

    while(nc > 0){
        d = nc % 10;
        nc = nc / 10;

        if(d == dig){
            c++;
        }
    }

    return c;
}

// 2) Encontrar el dígito más repetido
// Ej: 443333212 => 3
int digMasRepetido(int n){
    int nc = n, d = 0;
    int dmr = nc % 10;
    int frecMayor = frecuenciaDig(n, dmr);

    while(nc > 0){
        d = nc % 10;
        nc = nc / 10;

        if(frecuenciaDig(n, d) > frecMayor){
            frecMayor = frecuenciaDig(n, d);
            dmr = d;
        }
    }

    return dmr;
}

// ordenar ascendente
void ordenarAsc(int &n){
    int nn = 0, d = 0, na = n;

    for(int i=0; i<=9; i++){
        n = na;

        while(n > 0){
            d = n % 10;
            n = n / 10;

            if(d == i){
                nn = nn * 10 + d;
            }
        }
    }

    n = nn;
}

// ordenar descendente
void ordenarDesc(int &n){
    int nn = 0, d = 0, na = n;

    for(int i=9; i>=0; i--){
        n = na;

        while(n > 0){
            d = n % 10;
            n = n / 10;

            if(d == i){
                nn = nn * 10 + d;
            }
        }
    }

    n = nn;
}

// invertir numero
void invertir(int &n){
    int nn = 0, d = 0;

    while(n > 0){
        d = n % 10;
        n = n / 10;
        nn = nn * 10 + d;
    }

    n = nn;
}

// 3) Segmentar en no primos y primos desc
// Ej: 837532438 => 881753332
void segmentarNoPrimosPrimos(int &n){

    int nc = n, d = 0;
    int noPrimos = 0;
    int primos = 0;

    // formar numeros
    while(nc > 0){
        d = nc % 10;
        nc = nc / 10;

        if(esPrimo(d)){
            primos = primos * 10 + d;
        }else{
            noPrimos = noPrimos * 10 + d;
        }
    }

    // ordenar
    ordenarDesc(noPrimos);
    ordenarDesc(primos);

    // juntar
    int nn = noPrimos;

    int temp = primos;
    int c = 0;

    while(temp > 0){
        temp = temp / 10;
        c++;
    }

    nn = nn * (int)pow(10,c) + primos;

    n = nn;
}

// 4) Intercambiar posiciones
// 12345 => 14325
// 123456 => 153426
void intercambiarPosiciones(int &n){

    int nc = n;
    int nn = 0;
    int e = 0;

    while(nc > 0){

        int d1 = nc % 10;
        nc = nc / 10;

        if(nc > 0){
            int d2 = nc % 10;
            nc = nc / 10;

            nn = nn + d2 * pow(10,e);
            e++;

            nn = nn + d1 * pow(10,e);
            e++;
        }else{
            nn = nn + d1 * pow(10,e);
            e++;
        }
    }

    n = nn;
}

// 5) Intercalar mayor y menor
// Ej: 83256741 => 81726354
void intercalarMayorMenor(int &n){

    int asc = n;
    int desc = n;

    ordenarAsc(asc);
    ordenarDesc(desc);

    int nn = 0;

    while(desc > 0 || asc > 0){

        if(desc > 0){
            nn = nn * 10 + (desc % 10);
            desc = desc / 10;
        }

        if(asc > 0){
            nn = nn * 10 + (asc % 10);
            asc = asc / 10;
        }
    }

    n = nn;
}

