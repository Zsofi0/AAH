#include <iostream>
using namespace std;

int digitoMasRepetido(int n){
    int frecuencia[10]={0};

    while(n>0){
        int digito=n%10;
        frecuencia[digito]++;
        n=n/10;
    }

    int mayor=0;
    int digito=0;

    for(int i=0; i<=9;i++){
        if(frecuencia[i]>mayor){
            mayor =frecuencia[i];
            digito=i;
        }
    }

    return digito;
}

int main(){
    int n;

    cout<<"Ingresar numero: ";
    cin>>n;

    cout<<"Digito mas repetido: "
        <<digitoMasRepetido(n);

    return 0;
}


1) Encontrar el 2do dígito primo del número
#include <iostream>
using namespace std;

bool esPrimo(int n){
    if(n < 2) return false;

    for(int i = 2; i < n; i++){
        if(n % i == 0) return false;
    }

    return true;
}

int segundoDigitoPrimo(int n){
    int copia = n, invertido = 0;

    while(copia > 0){
        invertido = invertido * 10 + copia % 10;
        copia /= 10;
    }

    int cont = 0;

    while(invertido > 0){
        int dig = invertido % 10;

        if(esPrimo(dig)){
            cont++;

            if(cont == 2){
                return dig;
            }
        }

        invertido /= 10;
    }

    return -1;
}

int main(){
    int numero;

    cout<<"Ingresar numero: ";
    cin>>numero;

    cout<<"2do digito primo: "
        <<segundoDigitoPrimo(numero);

    return 0;
}

3) Segmentar en no primos y primos descendente
#include <iostream>
using namespace std;

bool esPrimo(int n){
    if(n < 2) return false;

    for(int i = 2; i < n; i++){
        if(n % i == 0) return false;
    }

    return true;
}

int ordenarDesc(int n){
    int resultado = 0;

    for(int i = 9; i >= 0; i--){
        int copia = n;

        while(copia > 0){
            int dig = copia % 10;

            if(dig == i){
                resultado = resultado * 10 + dig;
            }

            copia /= 10;
        }
    }

    return resultado;
}

int segmentar(int n){
    int primos = 0;
    int noPrimos = 0;

    while(n > 0){
        int dig = n % 10;

        if(esPrimo(dig)){
            primos = primos * 10 + dig;
        }else{
            noPrimos = noPrimos * 10 + dig;
        }

        n /= 10;
    }

    primos = ordenarDesc(primos);
    noPrimos = ordenarDesc(noPrimos);

    int resultado = noPrimos;

    int copia = primos;
    while(copia > 0){
        resultado *= 10;
        copia /= 10;
    }

    resultado += primos;

    return resultado;
}

int main(){
    int numero;

    cout<<"Ingresar numero: ";
    cin>>numero;

    cout<<"Resultado: "
        <<segmentar(numero);

    return 0;
}



5. Intercalar mayor y menor
#include <iostream>
using namespace std;

int ordenarAsc(int n){
    int r = 0;

    for(int i = 0; i <= 9; i++){
        int copia = n;

        while(copia > 0){
            int dig = copia % 10;

            if(dig == i){
                r = r * 10 + dig;
            }

            copia /= 10;
        }
    }

    return r;
}

int ordenarDesc(int n){
    int r = 0;

    for(int i = 9; i >= 0; i--){
        int copia = n;

        while(copia > 0){
            int dig = copia % 10;

            if(dig == i){
                r = r * 10 + dig;
            }

            copia /= 10;
        }
    }

    return r;
}

int main(){
    int numero;

    cout<<"Ingresar numero: ";
    cin>>numero;

    int mayor = ordenarDesc(numero);
    int menor = ordenarAsc(numero);

    cout<<"Mayor: "<<mayor<<endl;
    cout<<"Menor: "<<menor<<endl;

    return 0;
}
