#include <iostream>
using namespace std;

int formarPares(int n){
    int numeroCopia = n, digito = 0, resultado = 0, factor = 1;

    while(numeroCopia > 0){
        digito = numeroCopia % 10;
        numeroCopia = numeroCopia / 10;

        if(digito % 2 == 0){
            resultado = digito * factor + resultado;
            factor *= 10;
        }
    }
    return resultado;
}

int main(){
    int numero;
    cout<<"Ingresar numero: ";
    cin>>numero;

    cout<<"Numero pares: "<<formarPares(numero);

    return 0;
}
