void reemplazarNumero(int& n,int n1,int n2){
    int nn=0,e=0,d=0,nd=cantDig(n1);
    while(n>0){
        d=n%(int)pow(10,nd);
        n=n/(int)pow(10,nd);
        if(d==n1)
           nn= nn + n2 *(int)pow(10,e);
        else
           nn= nn + d *(int)pow(10,e);
        e+=nd;
    }
    n=nn;
}     
   
  //intercalar primos ASC y no primos DESC
  //n=2369871 =>2938761
  void ordenarAsc(int& n){
      int nn=0,d=0,na=n;
      for(int i=1;i<10;i++){
         n=na;
         while(n>0){
             d=n%10;
             n=n/10;
             if(d==i)nn=nn*10+d;
         }
      }
      n=nn;
  }
  
   void ordenarDes(int& n){
      int nn=0,d=0,na=n;
      for(int i=9;i>=0;i--){
         n=na;
         while(n>0){
             d=n%10;
             n=n/10;
             if(d==i)nn=nn*10+d;
         }
      }
      n=nn;
  }
  
  void invertir(int& n){
     int nn=0,d=0;
      while(n>0){
            d=n%10;
            n=n/10;
            nn=nn*10+d;
         }
        n=nn; 
  }
