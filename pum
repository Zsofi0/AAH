int main(){

    int n;

    cout<<"Ingresar numero: ";
    cin>>n;

    // 1
    cout<<"2do digito primo: "
        <<segundoDigPrimo(n)<<endl;

    // 2
    cout<<"Digito mas repetido: "
        <<digMasRepetido(n)<<endl;

    // 3
    int n1 = n;
    segmentarNoPrimosPrimos(n1);
    cout<<"Segmentado: "<<n1<<endl;

    // 4
    int n2 = n;
    intercambiarPosiciones(n2);
    cout<<"Intercambiar posiciones: "<<n2<<endl;

    // 5
    int n3 = n;
    intercalarMayorMenor(n3);
    cout<<"Intercalar mayor-menor: "<<n3<<endl;

    return 0;
}





