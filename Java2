public class Main {

    public static void main(String[] args) {

        System.out.println("Divisores Ascendentes");
        divisoresAsc(24);

        System.out.println("Divisores Descendentes");
        divisoresDesc(24);

        System.out.println("Cantidad de Divisores");
        System.out.println(cantDivisores(24));

        System.out.println("Divisores Pares");
        divisoresPares(24);

        System.out.println("Divisores Impares");
        divisoresImpares(24);
    }

    public static void divisoresAsc(int n){
        for (int i=1; i<=n; i++){
            if (n%i==0) {
                System.out.println(i);
            }
        }
    }

    public static void divisoresDesc(int n){
        for (int i=n; i>=1; i--){
            if (n%i==0){
                System.out.println(i);
            }
        }
    }

    public static int cantDivisores(int n){
        int contador=0;

        for (int i=1; i<=n; i++){
            if (n%i== 0) {
                contador++;
            }
        }

        return contador;
    }

    public static void divisoresPares(int n){
        for (int i=1; i<=n; i++){
            if (n%i==0 && i%2==0){
                System.out.println(i);
            }
        }
    }

    public static void divisoresImpares(int n) {
        for (int i=1; i<=n;i++){
            if (n%1==0 && i%2!=0){
                System.out.println(i);
            }
        }
    }
}
